{
  "name": "equipo-07-pipeline",
  "description": "Fotos de gasolina: Bronce → Plata → Oro, equipo 7",
  "max_concurrent_runs": 1,
  "queue": {"enabled": true},
  "schedule": {
    "quartz_cron_expression": "0 0 20 ? * TUE",
    "timezone_id": "America/Guatemala",
    "pause_status": "PAUSED"
  },
  "environments": [
    {
      "environment_key": "pipeline_serverless",
      "spec": {
        "environment_version": "6",
        "dependencies": [
          "pandas>=2.1",
          "requests>=2.31",
          "pillow-heif==1.8.1",
          "openai>=1,<3",
          "scikit-learn>=1.4,<2",
          "mlflow>=2.10,<4"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "01_bronce",
      "notebook_task": {
        "notebook_path": "/Shared/MLOPS/pipelines/01_bronze",
        "source": "WORKSPACE",
        "base_parameters": {
          "bronze_input_uri": "s3://cc3105-raw-869227452861-us-east-2-an/img/",
          "bronze_output_uri": "s3://cc3105-cusn-869227452861-us-east-2-an/",
          "silver_output_uri": "s3://cc3105-ag-869227452861-us-east-2-an/",
          "gold_output_uri": "s3://cc3105-au-869227452861-us-east-2-an/",
          "databricks_catalog": "workspace"
        }
      },
      "environment_key": "pipeline_serverless"
    },
    {
      "task_key": "02_plata",
      "depends_on": [{"task_key": "01_bronce"}],
      "notebook_task": {
        "notebook_path": "/Shared/MLOPS/pipelines/02_silver",
        "source": "WORKSPACE",
        "base_parameters": {
          "origen": "s3://cc3105-cusn-869227452861-us-east-2-an/equipo7/fotos_precios",
          "silver_uri": "s3://cc3105-ag-869227452861-us-east-2-an/equipo7",
          "catalogo": "workspace",
          "esquema": "equipo7",
          "modo": "incremental",
          "modelo": "databricks-llama-4-maverick",
          "lado_a": "1600",
          "lado_b": "2560",
          "precio_min": "15",
          "precio_max": "60",
          "limite_fotos": "0",
          "escribir": "si"
        }
      },
      "environment_key": "pipeline_serverless"
    },
    {
      "task_key": "03_oro",
      "depends_on": [{"task_key": "02_plata"}],
      "notebook_task": {
        "notebook_path": "/Shared/MLOPS/pipelines/03_gold",
        "source": "WORKSPACE",
        "base_parameters": {
          "bronze_input_uri": "s3://cc3105-raw-869227452861-us-east-2-an/img/",
          "bronze_output_uri": "s3://cc3105-cusn-869227452861-us-east-2-an/",
          "silver_output_uri": "s3://cc3105-ag-869227452861-us-east-2-an/",
          "gold_output_uri": "s3://cc3105-au-869227452861-us-east-2-an/",
          "databricks_catalog": "workspace",
          "umbral_q": "0.10",
          "semanas_test": "4",
          "mlflow_experiment": "/Shared/equipo7-gasolina",
          "usar_wti": "true"
        }
      },
      "environment_key": "pipeline_serverless"
    }
  ]
}
