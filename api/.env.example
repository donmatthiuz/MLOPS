# Crear api/.env únicamente en el Droplet, con permisos 600.
# Usar el bucket Oro asignado al equipo; el código agrega equipo7/ si falta.
GOLD_OUTPUT_URI=s3://bucket-oro/equipo7/
# Puerto externo asignado al equipo (80XX). Lo lee Docker Compose con --env-file.
API_PORT=8007
# Credenciales AWS de solo lectura sobre el prefijo Oro. deltalake las toma del entorno
# del contenedor; las del usuario Linux del Droplet (~/.aws) no se heredan.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo si las credenciales son temporales; dejar comentada en otro caso.
# AWS_SESSION_TOKEN=
